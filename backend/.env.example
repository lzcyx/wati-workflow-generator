# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit real keys.

# ----- LLM (any OpenAI-compatible endpoint) -----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# SDK-level retries for network / 5xx / rate-limit errors
LLM_MAX_RETRIES=2

# ----- Copilot / agent guardrails -----
# Max iterations of the bounded tool-calling loop
AGENT_MAX_ITERATIONS=6

# ----- Simulation engine -----
# Hard cap on steps per simulation run (guards against infinite loops)
SIM_MAX_STEPS=100

# ----- Server -----
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
